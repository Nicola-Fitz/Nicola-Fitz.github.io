
h1 {
  font-size: 1.4rem;
}

h2 {
  font-size: 1.4rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-top: 3rem;
  border-bottom: 1px solid #ddd;
  padding-bottom: 0.2rem;
}

h3 {
  font-size: 1rem;
}


.cv-entry {
  display: flex;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 0.6rem;
}

.cv-left {
  flex: 1;
}

.cv-right {
  white-space: nowrap;
  color: #555;
}

.cv-title {
  color: #1f4e79;
}

.cv-header h1,
.cv-header h2,
.cv-header h3 {
  margin: 0 !important;
  padding: 0;
  line-height: 1.1;
}

.cv-header h1 {
  margin-bottom: 0.5rem;
}

.cv-header h3 {
  margin-bottom: 0.2rem;
}

.cv-header {
  margin-bottom: 3rem;
}